		{
			"name": "Random joke (legacy)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
							"pm.test(\"Responds quickly (<1500ms)\", () => pm.expect(pm.response.responseTime).to.be.below(1500));",
							"const json = pm.response.json();",
							"pm.test(\"Body is an object\", () => pm.expect(typeof json).to.eql(\"object\"));",
							"pm.test(\"Has required joke fields\", () => { pm.expect(json).to.have.property(\"id\"); pm.expect(json).to.have.property(\"type\"); pm.expect(json).to.have.property(\"setup\"); pm.expect(json).to.have.property(\"punchline\"); });",
							"pm.test(\"Setup & punchline are non-empty\", () => { pm.expect(json.setup).to.be.a(\"string\").and.not.empty; pm.expect(json.punchline).to.be.a(\"string\").and.not.empty; });"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/random_joke",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"random_joke"
					]
				}
			},
			"response": []
